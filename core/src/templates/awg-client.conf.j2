# vpnctl · {{ user }} · mode {{ mode }} · entry {{ domain }}
[Interface]
Address = {{ address }}/32
PrivateKey = {{ private_key }}
DNS = {{ dns }}
Jc = 4
Jmin = 40
Jmax = 70
S1 = 0
S2 = 0
H1 = 1
H2 = 2
H3 = 3
H4 = 4

[Peer]
PublicKey = {{ server_public_key }}
PresharedKey = {{ preshared }}
AllowedIPs = 0.0.0.0/0, ::/0
Endpoint = {{ domain }}:{{ port }}
PersistentKeepalive = 25
