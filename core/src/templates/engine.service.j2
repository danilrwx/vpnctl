# vpnctl · {{ host }}
[Unit]
Description={{ engine }} ({{ host }})
After=network-online.target nftables.service
Wants=network-online.target

[Service]
ExecStart={{ exec }}
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
