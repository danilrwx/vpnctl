# vpnctl · {{ host }} · do not edit by hand: overwritten by apply
{
	admin off
}

https://{{ domain }}:{{ caddy_port }} {
	bind 127.0.0.1
	root * /var/www/site
	file_server
{% if ws_port %}
	@ws path {{ ws_path }}
	reverse_proxy @ws 127.0.0.1:{{ ws_port }}
{% endif %}
	handle_path /s/* {
		root * /var/www/sub
		header profile-title "{{ profile_title }}"
		header profile-update-interval "12"
		header Cache-Control "no-store"
		@singbox header User-Agent *sing-box*
		@clash header User-Agent *lash*
		rewrite @singbox {path}.json
		rewrite @clash {path}.yaml
		file_server
	}
}
{% if ntfy_domain %}
https://{{ ntfy_domain }}:{{ caddy_port }} {
	bind 127.0.0.1
	reverse_proxy 127.0.0.1:{{ ntfy_port }}
}
{% endif %}
http://{{ domain }} {
	redir https://{{ domain }}{uri} permanent
}
