# vpnctl · {{ host }}
[Unit]
Description=mtg MTProto proxy
After=network-online.target sing-box.service xray.service

[Service]
ExecStart=/usr/local/bin/mtg run /etc/mtg/config.toml
Restart=on-failure
RestartSec=3
# от root (конфиг 0600), но без лишнего: только bind на порт и только чтение системы
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
