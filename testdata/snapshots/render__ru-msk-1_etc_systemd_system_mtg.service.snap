# vpnctl · ru-msk-1
[Unit]
Description=mtg MTProto proxy
After=network-online.target sing-box.service xray.service

[Service]
ExecStart=/usr/local/bin/mtg run /etc/mtg/config.toml
Restart=on-failure
RestartSec=3
# runs as root (config 0600) but with no extras: port bind and read-only system access
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
