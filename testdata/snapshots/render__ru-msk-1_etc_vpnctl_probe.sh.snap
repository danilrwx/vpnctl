---
source: tests/render.rs
expression: body
---
#!/bin/sh
# vpnctl · chain probe on ru-msk-1 · every minute by vpnctl-probe.timer
set -u
PROBE_URL="https://www.gstatic.com/generate_204"
STATE=/var/lib/vpnctl/probe.state
REMIND=1800
now=$(date +%s)
last=0
was=ok
if [ -r "$STATE" ]; then
  read -r last was < "$STATE" || true
fi
case ${last:-} in ''|*[!0-9]*) last=0 ;; esac
was=${was:-ok}
# notifications are off: alerts.yaml has no topic
notify() { return 0; }

# what the chain is actually used for besides a 204: the fronting name of this
# host and a Telegram endpoint. Both failed silently once — the chain probe was
# green while the Telegram proxy was down for hours.
probe_socks() {
  name=$1
  url=$2
  scode=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 --socks5-hostname 127.0.0.1:1080 "$url" 2>/dev/null || true)
  case ${scode:-000} in
    000|"")
      printf 'socks path broken: %s\n' "$name"
      broken="$broken $name"
      ;;
  esac
}
code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 --socks5-hostname 127.0.0.1:1080 "$PROBE_URL" 2>/dev/null || true)
broken=""
probe_socks own "https://gw.example.ru"
probe_socks telegram "https://pluto.web.telegram.org"
mtg_warn=$(journalctl -u mtg --since "-2min" --no-pager 2>/dev/null | grep -c '"level":"warn"' || true)
case ${mtg_warn:-0} in
  0) ;;
  *) printf 'mtg warned %s times in two minutes\n' "$mtg_warn"
     broken="$broken mtg"
     ;;
esac

if [ "$code" = "204" ] && [ -z "$broken" ]; then
  printf 'ok 204\n'
  if [ "$was" = "fail" ]; then notify default "chain probe: recovered"; fi
  mkdir -p /var/lib/vpnctl && printf '%s ok\n' "$now" > "$STATE"
  exit 0
fi
printf 'chain probe: %s instead of 204\n' "${code:-no answer}"
if [ -n "$broken" ]; then printf 'broken paths:%s\n' "$broken"; fi
systemctl is-active --quiet sing-box || printf 'engine sing-box is not running\n' sing-box
if [ "$was" != "fail" ] || [ $((now - last)) -ge "$REMIND" ]; then
  notify high "chain probe returned ${code:-no answer}${broken:+; broken:$broken}"
  mkdir -p /var/lib/vpnctl && printf '%s fail\n' "$now" > "$STATE"
fi
exit 1
